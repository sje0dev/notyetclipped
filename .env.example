# Docker Compose: copy to .env, then docker compose up --build.
POSTGRES_PASSWORD=local-postgres-change-me
COMPOSE_PROFILES=local-storage
S3_ACCESS_KEY_ID=local-access-key
S3_SECRET_ACCESS_KEY=local-secret-change-me
S3_BUCKET=notyetclipped
S3_REGION=us-east-1
# Internal endpoint for API/worker; leave blank for AWS S3.
S3_ENDPOINT_URL=http://s3:9000
# Address reachable by YOUR browser, used for signed playback URLs.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
WEB_PORT=3000
# For bun run dev against a locally started API:
NUXT_API_BASE=http://127.0.0.1:8000
# Native backend development overrides (Compose sets these itself):
# DATABASE_URL=postgres://notyetclipped:local-postgres-change-me@localhost:5432/notyetclipped
# DATA_DIR=./data
# FFMPEG_BIN=ffmpeg
# STREAMLINK_BIN=streamlink
# RUST_LOG=notyetclipped=info,actix_web=info
# API_BIND=127.0.0.1:8000
